rules_version = '2';

// The one place a client writes directly.
//
// Everything else goes through the functions in this repo, because a client
// that can write its own balance would never need to buy anything. Pictures
// are the exception on purpose: they are megabytes, and pushing megabytes
// through a Cloud Function means paying for the function's time to move bytes
// it does nothing with.
//
// The opening is as narrow as it goes: one person's own folder, one file size,
// images only. Nothing here can reach Firestore.
//
// Written as two rules rather than one because allow clauses are ORed, so a
// broad `allow read, write` beside a careful one is simply the broad one.
service firebase.storage {
  match /b/{bucket}/o {

    match /users/{uid}/pictures/{pictureId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == uid;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && pictureId.matches('^[A-Za-z0-9_-]+$')
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
