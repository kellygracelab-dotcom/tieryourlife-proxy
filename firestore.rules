rules_version = '2';

// Everything here is written only by the functions in this repo, which use the
// Admin SDK and bypass these rules. Nothing else may touch it: a client that
// could write its own balance would not need to buy anything, and the boards an
// account keeps are not worth being the first exception to that.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
